<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\EliteFIPServer.Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <AssemblyName>EliteFIPServer</AssemblyName>
    <RootNamespace>EliteFIPServer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EliteFIPServer.Core\EliteFIPServer.Core.csproj" />
  </ItemGroup>

  <!-- Package.appxmanifest and Images\*.png are Store-packaging inputs only — MakeAppx (driven by
       Build-StorePackage.ps1) reads them directly from this project's build output. They are never
       given to MSBuild's own Appx packaging pipeline (WindowsPackageType stays None): that pipeline
       (GenerateAppxPackageOnBuild/PublishAppxPackage/EnableMsixTooling) never reliably produces a
       package for this project on the .NET 10 SDK, and opting into it previously broke the normal
       loose-exe build too — an unconditional PackageReference to Microsoft.Windows.SDK.BuildTools.MSIX
       (added only to satisfy that pipeline, even with ExcludeAssets="all") shifted NuGet's transitive
       version resolution enough to crash EliteFIPServer.exe at startup inside Microsoft.UI.Xaml.dll,
       for every build, not just MSIX ones. See docs/HANDOFF.md for the full incident writeup and the
       working manual-packaging alternative. -->
  <ItemGroup>
    <None Include="Package.appxmanifest" />
    <Content Include="Images\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\EliteFIPServerIcon256.ico" Link="EliteFIPServerIcon256.ico" CopyToOutputDirectory="Always" />
    <Content Include="..\NLog.config" Link="NLog.config" CopyToOutputDirectory="Always" />
    <Content Include="..\EliteFIPServer.Core\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- Runs before BeforeBuild (i.e. before reference resolution and CoreCompile) so the rewritten
       BuildInfo.cs is what gets compiled. BeforeTargets="Build" is too late: Build's dependencies,
       including compilation, run first, so the exe always carried the previous build's version.
       Version.props was already imported at evaluation time, so the bumped value is read back and
       re-applied to the version properties for GenerateAssemblyInfo.
       The WinUI/Windows SDK targets re-enter this project's Build a second time in the same build
       with BuildProjectReferences=false; bumping there too advanced the version by 2 per build, so
       only the primary instance bumps and every instance applies the bumped value.
       _BumpedVersionFile is defined inside the targets because IntermediateOutputPath is not yet set
       when this project body is evaluated (the SDK defines it later, in Sdk.targets). -->
  <Target Name="UpdateBuildVersion" BeforeTargets="BeforeBuild" Condition="'$(BuildProjectReferences)' != 'false'">
    <PropertyGroup>
      <_BumpedVersionFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)BumpedVersion.txt</_BumpedVersionFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\UpdateBuildVersion.ps1&quot; -VersionPropsPath &quot;$(MSBuildProjectDirectory)\..\EliteFIPServer.Version.props&quot; -BuildInfoPath &quot;$(MSBuildProjectDirectory)\BuildInfo.cs&quot; -AppxManifestPath &quot;$(MSBuildProjectDirectory)\Package.appxmanifest&quot; -VersionOutputPath &quot;$(_BumpedVersionFile)&quot;" />
  </Target>

  <Target Name="ApplyBumpedVersion" AfterTargets="UpdateBuildVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_BumpedVersionFile>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)BumpedVersion.txt</_BumpedVersionFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(_BumpedVersionFile)" Condition="Exists('$(_BumpedVersionFile)')">
      <Output TaskParameter="Lines" PropertyName="_BumpedVersion" />
    </ReadLinesFromFile>
    <PropertyGroup Condition="'$(_BumpedVersion)' != ''">
      <Version>$(_BumpedVersion)</Version>
      <AssemblyVersion>$(_BumpedVersion)</AssemblyVersion>
      <FileVersion>$(_BumpedVersion)</FileVersion>
      <InformationalVersion>$(_BumpedVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <Target Name="SignLocalDevBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and '$(EnableDevCodeSigning)' != 'false'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\Sign-DevBuild.ps1&quot; -OutputDirectory &quot;$(TargetDir).&quot; -ExportCertificate" />
  </Target>

</Project>
