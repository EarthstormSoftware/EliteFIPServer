<Page
    x:Class="EliteFIPServer.SettingsHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Padding="0,16,0,0">
            <TextBlock Text="General settings" FontWeight="SemiBold" Margin="0,8,0,4" />
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Enable logging" FontWeight="SemiBold" /><TextBlock Text="Write server activity to the log file" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding EnableLog, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Log files" FontWeight="SemiBold" /><TextBlock Text="Open the folder that holds the log files and saved settings" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <Button Grid.Column="1" Content="Open log folder" Click="OpenLogFolder_Click" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Dark mode" FontWeight="SemiBold" /><TextBlock Text="Use the dark application theme" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding DarkMode, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Window behaviour" FontWeight="SemiBold" Margin="0,16,0,4" />
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Start with Windows" FontWeight="SemiBold" /><TextBlock x:Name="StartWithWindowsDescription" Text="Launch the application when you sign in to Windows" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch x:Name="StartWithWindowsToggle" Grid.Column="1" IsEnabled="False" Toggled="StartWithWindows_Toggled" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Minimise to tray" FontWeight="SemiBold" /><TextBlock Text="Hide the window to a system tray icon instead of the taskbar when minimised" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding MinimiseToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Start minimised" FontWeight="SemiBold" /><TextBlock Text="Launch the application straight to the tray, with no window shown" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding StartMinimised, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Text="Integrations" FontWeight="SemiBold" Margin="0,16,0,4" />
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="MatricSettings_Click">
                        <StackPanel Spacing="2"><TextBlock Text="Matric integration" FontWeight="SemiBold" /><TextBlock Text="Connection, startup, and button settings" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    </Button>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding AutostartMatricIntegration, Mode=TwoWay}" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <TextBlock Text="Panel Server settings" FontWeight="SemiBold" Margin="0,16,0,4" />
            <InfoBar Severity="Warning" IsClosable="True" IsOpen="True"
                     Visibility="{Binding PanelRestartRequired, Converter={StaticResource BoolToVisibilityConverter}}"
                     Title="Restart required"
                     Message="Panel Server settings have changed. Stop and start the Panel Server to apply them."
                     CloseButtonClick="PanelRestartInfoBar_CloseButtonClick" />
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Allow LAN access" FontWeight="SemiBold" /><TextBlock Text="Allow other devices on your local network to connect" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding PanelServerAllowLanAccess, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Start Panel Server automatically" FontWeight="SemiBold" /><TextBlock Text="Start the Panel Server when the application launches" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding AutostartPanelServer, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Custom panels" FontWeight="SemiBold" /><TextBlock Text="Serve your own pages, and your edited copies of the built-in ones, from the panels folder in Documents" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Open panels folder" Click="OpenPanelsFolder_Click" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{Binding UseCustomPanels, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Panel Server port" FontWeight="SemiBold" /><TextBlock Text="Port used by the Panel Server" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <NumberBox Grid.Column="1" Width="180" Value="{Binding PanelServerPort, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
