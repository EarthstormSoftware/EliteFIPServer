<Page
    x:Class="EliteFIPServer.MatricSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="8" HorizontalAlignment="Stretch" Padding="0,8,0,0">
            <Button HorizontalAlignment="Left" Click="Back_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72B;" />
                    <TextBlock Text="Back to Main settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="Matric integration" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,8" />

            <InfoBar Severity="Warning" IsClosable="True" IsOpen="True"
                     Visibility="{Binding MatricRestartRequired, Converter={StaticResource BoolToVisibilityConverter}}"
                     Title="Restart required"
                     Message="Matric settings have changed. Stop and start Matric integration to apply them."
                     CloseButtonClick="MatricRestartInfoBar_CloseButtonClick" />

            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Start automatically" FontWeight="SemiBold" /><TextBlock Text="Start the Matric service when the application launches" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsOn="{Binding AutostartMatricIntegration, Mode=TwoWay}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Matric API port" FontWeight="SemiBold" /><TextBlock Text="Port used by the Matric integration" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <NumberBox Grid.Column="1" Width="180" Value="{Binding MatricApiPort, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Padding="16,12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2"><TextBlock Text="Retry interval" FontWeight="SemiBold" /><TextBlock Text="Seconds between connection attempts" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
                    <NumberBox Grid.Column="1" Width="180" Value="{Binding MatricRetryInterval, Mode=TwoWay}" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Grid Margin="0,16,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Automatic page switching" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Reset to defaults" Click="ResetPageSwitches_Click" />
            </Grid>
            <TextBlock Text="Switch all connected Matric clients to a page when entering a game state. Matric page IDs are required; copy them from Matric." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding MatricPageSwitchConfigs}" SelectionMode="None" Margin="0,4,0,8">
                <ListView.Header>
                    <Grid ColumnSpacing="12" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="400" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="State" FontWeight="SemiBold" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Matric Page ID" FontWeight="SemiBold" HorizontalAlignment="Left" /><TextBlock Grid.Column="2" Text="Enabled" FontWeight="SemiBold" HorizontalAlignment="Left" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,4">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="400" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StateDisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding PageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Matric page ID" />
                                <ToggleSwitch Grid.Column="2" IsOn="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Margin="0,16,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Client profiles" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Add client profile" Click="AddClientProfile_Click" />
            </Grid>
            <TextBlock Text="Override deck and page settings for individual Matric devices. Client IDs are shown on the Clients tab." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding MatricClientProfiles}" SelectionMode="None" Margin="0,4,0,8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,8">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <Border BorderBrush="{Binding ClientIdBorderBrush}" BorderThickness="1" CornerRadius="2">
                                            <ComboBox ItemsSource="{Binding AvailableClients}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedClient, Mode=TwoWay}" PlaceholderText="Select connected client" />
                                        </Border>
                                        <TextBlock Text="{Binding ClientIdValidationText}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="12" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ClientName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Device name (optional)" />
                                    <Button Grid.Column="2" Content="Remove" Click="RemoveClientProfile_Click" />
                                </Grid>
                                <TextBox Header="Matric deck ID" Text="{Binding DeckId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional" />
                                <Grid ColumnSpacing="12" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="380" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="State" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="1" Text="Matric Page ID" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Grid.Column="2" Text="Enabled" FontWeight="SemiBold" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PageSwitches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="12" Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="380" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding StateDisplayName}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Text="{Binding PageId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Matric page ID" />
                                                <ToggleSwitch Grid.Column="2" IsOn="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Margin="0,16,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="Button text" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Reset to defaults" Click="Reset_Click" />
            </Grid>
            <TextBlock Text="Customize labels sent to Matric for supported controls." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            <ListView ItemsSource="{Binding MatricButtonTextConfigs}" SelectionMode="None" Margin="0,4,0,16">
                <ListView.Header>
                    <Grid ColumnSpacing="12" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Button" FontWeight="SemiBold" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Off text" FontWeight="SemiBold" HorizontalAlignment="Left" /><TextBlock Grid.Column="2" Text="On text" FontWeight="SemiBold" HorizontalAlignment="Left" /><TextBlock Grid.Column="3" Text="Update" FontWeight="SemiBold" HorizontalAlignment="Left" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ButtonName}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding OffText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2" Text="{Binding OnText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleSwitch Grid.Column="3" IsOn="{Binding UpdateButtonText, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
