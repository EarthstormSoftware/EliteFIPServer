<Window
    x:Class="EliteFIPServer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Elite FIP Server">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabView Margin="16,12,16,0" IsAddTabButtonVisible="False" CanDragTabs="False">
            <TabViewItem Header="Status" IsClosable="False">
                <ScrollViewer>
                    <Grid MaxWidth="680" HorizontalAlignment="Left" Padding="0,20,0,0" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="2" Text="Status" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" Text="Control" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />

                        <TextBlock Grid.Row="1" Text="Core Server" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Grid Grid.Row="1" Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Center">
                            <Ellipse x:Name="coreStatusIndicator" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ProgressRing x:Name="coreStatusProgress" Width="24" Height="24" />
                        </Grid>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CoreStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="-" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Grid.Row="2" Text="Matric Integration" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Grid Grid.Row="2" Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Center">
                            <Ellipse x:Name="matricStatusIndicator" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ProgressRing x:Name="matricStatusProgress" Width="24" Height="24" />
                        </Grid>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MatricStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button Grid.Row="2" Grid.Column="3" MinWidth="120" Content="{Binding MatricButtonText}" IsEnabled="{Binding MatricButtonEnabled}" Click="CmdMatric_Click" />

                        <TextBlock Grid.Row="3" Text="Panel Server" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Grid Grid.Row="3" Grid.Column="1" Width="24" Height="24" HorizontalAlignment="Center">
                            <Ellipse x:Name="panelStatusIndicator" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ProgressRing x:Name="panelStatusProgress" Width="24" Height="24" />
                        </Grid>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding PanelStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <Button Grid.Row="3" Grid.Column="3" MinWidth="120" Content="{Binding PanelButtonText}" IsEnabled="{Binding PanelButtonEnabled}" Click="CmdPanel_Click" />
                    </Grid>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Settings" IsClosable="False">
                <Frame x:Name="SettingsFrame">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromHorizontalOffset="48" />
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </TabViewItem>

            <TabViewItem Header="Clients" IsClosable="False">
                <Grid Padding="0,16,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="cmdRefreshClients" Content="Refresh" MinWidth="96" Click="CmdRefreshClients_Click" />
                    </StackPanel>

                    <ListView Grid.Row="1" ItemsSource="{Binding MatricClients}" HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="None">
                        <ListView.Header>
                            <Border Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Name" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="IP" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Client ID" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Content="&#xE8C8;" Tag="{Binding Name}" Click="CopyClientValue_Click" ToolTipService.ToolTip="Copy name" Padding="6,2" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding IP}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Content="&#xE8C8;" Tag="{Binding Id}" Click="CopyClientValue_Click" ToolTipService.ToolTip="Copy client ID" Padding="6,2" />
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2" Text="{Binding ClientCountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Activity" IsClosable="False">
                <Grid Padding="0,16,0,0" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear" MinWidth="96" Click="CmdClearActivity_Click" />
                    </StackPanel>

                    <ListView x:Name="lstActivity" Grid.Row="1" ItemsSource="{Binding ActivityLog}" HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="None">
                        <ListView.Header>
                            <Border Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Time" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Message" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,8" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding DisplayTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>
        </TabView>

        <Border Grid.Row="1" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="coreSummaryIndicator" Width="9" Height="9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Core" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding CoreStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <Rectangle Grid.Column="3" Width="1" Height="16" VerticalAlignment="Center" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <Ellipse x:Name="matricSummaryIndicator" Grid.Column="4" Width="9" Height="9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="Matric" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="6" Text="{Binding MatricStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                <Rectangle Grid.Column="7" Width="1" Height="16" VerticalAlignment="Center" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="8" Orientation="Horizontal" Spacing="12">
                    <Ellipse x:Name="panelSummaryIndicator" Width="9" Height="9" VerticalAlignment="Center" />
                    <TextBlock Text="Panel" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding PanelStatus}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="9" Text="{Binding VersionText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>