<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DARK THEME COLORS -->
    <Color x:Key="ThemeColor">#40a6d1</Color>
    <Color x:Key="ThemeRedColor">#ff6b6b</Color>
    <Color x:Key="ThemeColorDark">#3992b8</Color>
    <Color x:Key="ThemeColorDarker">#2d6f94</Color>
    <Color x:Key="ThemeColorInactive">#5dd4ff</Color>
    <Color x:Key="ThemeColorActive">#64d9ff</Color>
    
    <!-- Background Colors -->
    <Color x:Key="BackgroundColor">#2d2d2d</Color>
    <Color x:Key="SecondaryBackgroundColor">#3a3a3a</Color>
    <Color x:Key="BorderColor">#4a4a4a</Color>
    
    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#ffffff</Color>
    <Color x:Key="SecondaryTextColor">#b0b0b0</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="ThemeBrush" Color="{DynamicResource ThemeColor}" />
    <SolidColorBrush x:Key="ThemeBrushDark" Color="{DynamicResource ThemeColorDark}" />
    <SolidColorBrush x:Key="ThemeBrushDarker" Color="{DynamicResource ThemeColorDarker}" />
    <SolidColorBrush x:Key="ThemeBrushInactive" Color="{DynamicResource ThemeColorInactive}" />
    <SolidColorBrush x:Key="ThemeBrushActive" Color="{DynamicResource ThemeColorActive}" />
    <SolidColorBrush x:Key="ThemeRedBrush" Color="{DynamicResource ThemeRedColor}" />
    
    <SolidColorBrush x:Key="Theme_Brush_Bg" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="Theme_Brush_SilverBorder" Color="#555555" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{DynamicResource BackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{DynamicResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />

</ResourceDictionary>
