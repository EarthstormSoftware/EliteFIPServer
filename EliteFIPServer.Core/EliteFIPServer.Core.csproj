<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\EliteFIPServer.Version.props" />
  <Import Project="..\EliteFIPServer.Matric.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>EliteFIPServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.11" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="EliteAPI">
      <HintPath>..\..\EliteAPI\EliteAPI\bin\Release\netstandard2.0\EliteAPI.dll</HintPath>
    </Reference>
    <Reference Include="EliteFIPProtocol">
      <HintPath>..\..\EliteFIPProtocol\EliteFIPProtocol\bin\Release\net10.0\EliteFIPProtocol.dll</HintPath>
    </Reference>
    <Reference Include="MatricIntegration">
      <HintPath>$(MatricIntegrationPath)</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>PublicSettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <Target Name="BuildUiWhenCoreBuilds" BeforeTargets="Build" Condition="'$(IsUiBuildTriggeredFromCore)' != 'true'">
    <MSBuild Projects="..\EliteFIPServer.UI\EliteFIPServer.UI.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);BuildProjectReferences=false;IsUiBuildTriggeredFromCore=true" />
  </Target>

</Project>

